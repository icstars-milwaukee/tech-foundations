# Copy this file to .env and fill in the real values.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Mac / Git Bash:        cp .env.example .env
# .env is in .gitignore. NEVER commit it. The key below is a shared practice key;
# a real key would never go in this file.

API_BASE_URL=http://localhost:3001
API_KEY=w9c-practice-key
ITEM_ID=101

# Optional. These are the defaults; remove the # to change one.
# How long to wait for an answer, in milliseconds:
# REQUEST_TIMEOUT_MS=3000
# Extra tries after a network error, a 429, or a 5xx:
# MAX_RETRIES=2
# Set to json for one JSON object per log line:
# LOG_FORMAT=text
