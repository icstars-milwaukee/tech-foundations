# Sandbox settings. Copy to .env:   cp .env.example .env
# The demo app talks to the API THROUGH the chaos proxy (port 4100),
# so you can inject failures without touching anyone's wifi.

API_BASE_URL=http://localhost:4100
DEMO_API_KEY=replace-me
# live = use the API, fall back to cache if it fails
# offline = always use the cached/seed data (your emergency switch)
DEMO_MODE=live
