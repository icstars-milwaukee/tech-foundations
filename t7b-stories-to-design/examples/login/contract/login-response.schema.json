{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LoginResponse",
  "description": "What POST /api/auth/login returns with status 200.",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1,
      "description": "Session token. The frontend sends it with every later request."
    },
    "user": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "description": "Shown on the Dashboard greeting." }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    }
  },
  "required": ["token", "user"],
  "additionalProperties": false
}
